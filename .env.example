# Claude API (Anthropic)
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6

# Mistral OCR
MISTRAL_API_KEY=...
MISTRAL_OCR_ENDPOINT=https://api.mistral.ai/v1/ocr

# App
NODE_ENV=development
LOG_LEVEL=info
MAX_PDF_SIZE_MB=80

# Admin — senhas por área (acessos separados).
# ADMIN_PASSWORD é a senha da área de Regras e o fallback das demais áreas.
ADMIN_PASSWORD=troque-esta-senha
# Senha própria da área de Usuários (se vazia, usa ADMIN_PASSWORD).
USERS_ADMIN_PASSWORD=
# Senha própria da área de Estatísticas (se vazia, usa ADMIN_PASSWORD).
STATS_ADMIN_PASSWORD=
# Caminho do arquivo de regras (em produção, aponte para o volume Railway, ex: /data/rules.json)
RULES_STORE_PATH=

# Sessão de login (assinatura do cookie). Se vazio, usa ADMIN_PASSWORD.
SESSION_SECRET=troque-por-um-segredo-aleatorio
# Opcional: caminhos dos stores de contas e contador (padrão: mesmo diretório de RULES_STORE_PATH)
USERS_STORE_PATH=
ANALYTICS_STORE_PATH=
